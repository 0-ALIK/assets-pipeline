{
  "name": "assets-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @assets-pipeline/desktop dev",
    "lint": "eslint apps packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "cli": "pnpm --filter @assets-pipeline/cli start"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.40.0"
  }
}
