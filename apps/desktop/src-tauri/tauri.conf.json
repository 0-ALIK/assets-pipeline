{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Assets Pipeline",
  "version": "0.1.0",
  "identifier": "com.assetspipeline.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Assets Pipeline",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["assets-pipeline"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
