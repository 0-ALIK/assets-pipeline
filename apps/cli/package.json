{
  "name": "@assets-pipeline/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "assets-pipeline": "./dist/index.js"
  },
  "scripts": {
    "build": "pnpm --filter @assets-pipeline/core build && tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @assets-pipeline/core build && tsc -p tsconfig.json --noEmit",
    "test": "node --test test/integration.test.mjs",
    "start": "pnpm --filter @assets-pipeline/core build && tsx src/index.ts",
    "dev": "pnpm --filter @assets-pipeline/core build && tsx watch src/index.ts"
  },
  "dependencies": {
    "@assets-pipeline/core": "workspace:*",
    "ase-parser": "^0.0.19",
    "commander": "^14.0.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6"
  }
}
